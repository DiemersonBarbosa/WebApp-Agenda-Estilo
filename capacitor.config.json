{
  "appId": "com.agendaestilo.app",
  "appName": "BarberGestor",
  "webDir": "out",
  "server": {
    "url": "https://www.agendaestilo.com.br",
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "Keyboard": {
      "resize": "none",
      "style": "dark",
      "resizeOnFullScreen": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}